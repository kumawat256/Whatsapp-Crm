# Copy to .env and adjust for your environment.
#
# Local dev on this machine runs natively (no Docker): api/web as host
# processes, MySQL via XAMPP.
# docker-compose.yml is kept for later server/self-hosted deployment.
NODE_ENV=development

# --- Ports (host side) ---
API_PORT=3000
WEB_PORT=5174
MYSQL_PORT=3306

# --- MySQL ---
MYSQL_USER=whatsapp_crm
MYSQL_PASSWORD=whatsapp_crm
MYSQL_DATABASE=whatsapp_crm
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Derived DB URL used by the api process/container ---
# Local dev (XAMPP, passwordless root): mysql://root@localhost:3306/whatsapp_crm
# Docker/server deployment: mysql://whatsapp_crm:whatsapp_crm@mysql:3306/whatsapp_crm
DATABASE_URL=mysql://root@localhost:3306/whatsapp_crm

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5174

# --- Local filesystem storage ---
# Native dev: relative path resolved from apps/api. Docker: /app/storage.
STORAGE_ROOT=../../storage

SESSION_ENCRYPTION_KEY=c18102148fb307f8d161679e0550ae3263f27fa807b662f229c5f3e718c88cb6
