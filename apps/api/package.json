    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
